{
  "opencollection": "1.0.0",
  "info": {
    "name": "Narakeet Account API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get remaining account credits",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.narakeet.com/account/credits"
          },
          "docs": "Returns the quantity of credit seconds still available on the account, together with the billing plan and identity metadata for the API key."
        }
      ]
    }
  ],
  "bundled": true
}